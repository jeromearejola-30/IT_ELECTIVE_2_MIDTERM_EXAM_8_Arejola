@model IEnumerable<ConferenceCheckIn.Models.AttendeeVisit>

@{
    ViewData["Title"] = "Monitoring List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Attendee Check-In Monitoring</h2>
    <a asp-action="Create" class="btn btn-primary">Register New Attendee</a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Search by ticket, name, or organization..." />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Ticket #</th>
            <th>Attendee</th>
            <th>Organization</th>
            <th>Check-In</th>
            <th>Check-Out</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TicketNumber</td>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Organization</td>
                <td>@item.CheckInTime.ToString("g")</td>
                <td>@(item.CheckOutTime.HasValue ? item.CheckOutTime.Value.ToString("g") : "N/A")</td>
                <td>
                    @if (item.Status == "Present")
                    {
                        <span class="badge bg-success">Present</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Left Event</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    @if (item.Status == "Present")
                    {
                        <a asp-action="Checkout" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Check-Out</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>